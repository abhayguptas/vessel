# Vessel — Environment Configuration
# Copy this file to .env and customize as needed.
# All values below are development defaults; replace secrets before production use.

# ─── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://vessel_admin:secret_password@localhost:5432/vessel_db

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── NATS ────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── User Service ────────────────────────────────────────
USER_SERVICE_PORT=3001

# ─── Job Service ─────────────────────────────────────────
JOB_SERVICE_PORT=3002

# ─── JWT / Auth ──────────────────────────────────────────
# IMPORTANT: Change these in production!
JWT_SECRET=super_secret_vessel_key_change_in_prod
JWT_EXPIRES_IN=1h
REFRESH_SECRET=super_secret_refresh_key_change_in_prod
REFRESH_EXPIRES_IN=7d

# ─── Execution Agent ────────────────────────────────────
WORKER_NODE_ID=worker-local-1

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=info
# NODE_ENV=production  # Uncomment for production (disables pino-pretty)
