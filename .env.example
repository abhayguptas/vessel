# Vessel — Environment Configuration
# Copy this file to .env and customize as needed.

# ─── Deployment Target ──────────────────────────────────
# Allowed values: development, production
NODE_ENV=development

# ─── Public URLs & CORS ─────────────────────────────────
# The public domain/IP where the frontend and API are hosted
# Examples: http://localhost:5173, https://demo.vessel.dev
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3002/api/v1/jobs

# ─── PostgreSQL ──────────────────────────────────────────
# In docker-compose, this will typically point to the `postgres` host
DATABASE_URL=postgresql://vessel_admin:secret_password@localhost:5432/vessel_db

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── NATS JetStream ──────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── Services ────────────────────────────────────────────
USER_SERVICE_PORT=3001
JOB_SERVICE_PORT=3002

# ─── JWT / Auth ──────────────────────────────────────────
# IMPORTANT: Generate new secure secrets for production!
JWT_SECRET=super_secret_vessel_key_change_in_prod
JWT_EXPIRES_IN=1h
REFRESH_SECRET=super_secret_refresh_key_change_in_prod
REFRESH_EXPIRES_IN=7d

# ─── Execution Agent & Security ──────────────────────────
WORKER_NODE_ID=worker-local-1
# Maximum execution time (in seconds) for a Docker workload
WORKER_EXECUTION_TIMEOUT_SEC=300
# Maximum memory per Docker container
WORKER_MEM_LIMIT_MB=256
# Maximum CPU quota per container (e.g. 0.5 = half a core)
WORKER_CPU_LIMIT=0.5

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=info
